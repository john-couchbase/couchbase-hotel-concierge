{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/live",
      "dest": "/api/index.py?route=page&mode=live"
    },
    {
      "src": "/",
      "dest": "/api/index.py?route=page"
    },
    {
      "src": "/api/(state|chat|confirm|reset|login|health)",
      "dest": "/api/index.py?route=$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
